# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
# Only ignore a virtualenv named `env` at the repo root, not the bang_rl/env
# source package.
/env/

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local configuration and secrets
.env
.env.*
!.env.example

# Per-machine AI-training hardware and training settings (cpu cores, workers,
# RAM, batch size, buffer size, episodes, mode). The GUI persists these via
# SettingsEditor.save() and the config loader can read any of these paths, so
# they must not be committed and each computer keeps its own settings.
config.json
config.yaml
config.yml
config/default.yaml
config/default.yml
config/default.json
# Keep the committed example template tracked.
!config.example.yaml
!*.example

# Generated Bang RL artifacts and runtime data
bang_rl/models/*
!bang_rl/models/.gitkeep
bang_rl/logs/*
!bang_rl/logs/.gitkeep
bang_rl/datasets/canonical/*
!bang_rl/datasets/canonical/.gitkeep
bang_rl/datasets/cache/*
!bang_rl/datasets/cache/.gitkeep
bang_rl/replays/*
!bang_rl/replays/.gitkeep

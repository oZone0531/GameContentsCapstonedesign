# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
# Only ignore a virtualenv named `env` at the repo root, not the bang_rl/env
# source package.
/env/

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local configuration and secrets
.env
.env.*
!.env.example

# Generated Bang RL artifacts and runtime data
bang_rl/models/*
!bang_rl/models/.gitkeep
bang_rl/logs/*
!bang_rl/logs/.gitkeep
bang_rl/datasets/canonical/*
!bang_rl/datasets/canonical/.gitkeep
bang_rl/datasets/cache/*
!bang_rl/datasets/cache/.gitkeep
bang_rl/replays/*
!bang_rl/replays/.gitkeep
# Generated GUI replays stay local. Curated, reproducible training sets live in
# this explicitly trackable subdirectory and can be committed normally.
!bang_rl/replays/training/
!bang_rl/replays/training/.gitkeep
!bang_rl/replays/training/**/*.json
config.json
